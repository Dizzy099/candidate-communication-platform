# Copy to simulator/.env. Placeholders only.
SIM_DEBUG=true
SIM_DJANGO_SECRET_KEY=change-me
SIM_ALLOWED_HOSTS=localhost,127.0.0.1
# Must equal PROVIDER_API_KEY in backend/.env
SIM_API_KEY=local-dev-provider-key
# Must equal PROVIDER_WEBHOOK_SECRET in backend/.env
SIM_WEBHOOK_SECRET=local-dev-webhook-secret
SIM_DELIVERY_DELAY_SECONDS=3
SIM_READ_DELAY_SECONDS=8
SIM_RATE_LIMIT_PER_SECOND=20
SIM_RATE_LIMIT_BURST=40
