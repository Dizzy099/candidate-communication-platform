# Copy to backend/.env for local development. Placeholders only - never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave unset for SQLite (backend/db.sqlite3). PostgreSQL example:
# DATABASE_URL=postgres://ccp:ccp@localhost:5432/ccp
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Communication provider (the SimuText simulator in /simulator)
PROVIDER_BACKEND=simulator
PROVIDER_BASE_URL=http://127.0.0.1:8001
# Must match SIM_API_KEY in simulator/.env
PROVIDER_API_KEY=local-dev-provider-key
# Must match SIM_WEBHOOK_SECRET in simulator/.env
PROVIDER_WEBHOOK_SECRET=local-dev-webhook-secret
# Where the provider can reach this API for status webhooks
PUBLIC_WEBHOOK_BASE_URL=http://127.0.0.1:8000
PROVIDER_TIMEOUT_SECONDS=5

# Show the "simulate outage" control in the UI (simulator only)
DEMO_CONTROLS_ENABLED=true

# Retry tuning
MESSAGE_MAX_ATTEMPTS=5
MESSAGE_AUTO_ATTEMPTS=3
RETRY_BACKOFF_BASE_SECONDS=2
RETRY_BACKOFF_MAX_SECONDS=60
